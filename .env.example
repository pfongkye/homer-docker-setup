# Copy to .env and fill in the empty values: cp .env.example .env
# Never commit .env. Homer reads this whole file (env_file in docker-compose.yml);
# after changing it, apply with: docker compose up -d homer
# Step-by-step guides: docs/how-to/

# ---------------------------------------------------------------------------
# Homer
# ---------------------------------------------------------------------------

# Host port Homer listens on. Change it if 3000 is taken on your machine.
HOMER_PORT=3000

# Base path of Homer's API. Slack and GitLab call <homer-url>/api/v1/homer/...
# Keep the default: start-tunnels.sh builds the webhook and Slack URLs with it.
API_BASE_PATH=/api/v1/homer

# Email domains of your organisation, comma separated. Homer matches a GitLab
# username to the Slack user whose email is <username>@<domain>.
# Example: my-company.com,ext.my-company.com
EMAIL_DOMAINS=my-domain.com

# Link pattern for tickets in release changelogs. Must contain {ticketId}.
# Example: https://my-company.atlassian.net/browse/{ticketId}
TICKET_MANAGEMENT_URL_PATTERN=https://my-ticket-management.com/view/{ticketId}

# Maximum size of request bodies Homer accepts.
REQUEST_BODY_SIZE_LIMIT=5mb

# ---------------------------------------------------------------------------
# Postgres (homer-postgres container)
# ---------------------------------------------------------------------------

# Service name of the database inside the compose network. Do not change.
POSTGRES_HOST=postgres

# Used both as the host port and as the port Homer connects to inside the
# compose network: keep 5432. If 5432 is taken on your machine, stop whatever
# uses it rather than changing this value.
POSTGRES_PORT=5432

POSTGRES_USER=homer

# Choose any value. It is applied when the database volume is first created;
# changing it later requires deleting the volume (docker compose down -v).
# Generate one with: openssl rand -hex 16
POSTGRES_PASSWORD=

POSTGRES_DATABASE_NAME=homer

# ---------------------------------------------------------------------------
# GitLab (homer-gitlab container), guide: docs/how-to/gitlab-setup.md
# ---------------------------------------------------------------------------

# Password of the GitLab `root` user, applied on the first boot only.
# GitLab rejects weak or common passwords (at least 8 characters).
# Generate one with: openssl rand -base64 24
GITLAB_ROOT_PASSWORD=

# How Homer reaches GitLab inside the compose network. Do not change.
GITLAB_URL=http://gitlab:8929

# Token Homer uses for the GitLab API (also used by start-tunnels.sh to update
# the webhook). Fill it after GitLab is up:
#   1. Log in to http://localhost:8929 as root
#   2. Admin area -> Users -> New user, e.g. homer-service
#   3. As that user (Admin area -> Users -> Impersonate):
#      Preferences -> Access tokens -> Add new token, scope `api`
#   4. Add the user as Maintainer to every project Homer manages
GITLAB_TOKEN=

# Shared secret GitLab sends in webhooks so Homer can trust them. You create it:
#   openssl rand -base64 32
# Use the same value as the "Secret token" of the project webhook
# (start-tunnels.sh sets it for you).
GITLAB_SECRET=

# ---------------------------------------------------------------------------
# Slack app, guide: docs/how-to/slack-app.md
# Create the app first: https://api.slack.com/apps -> Create New App ->
# From an app manifest -> paste https://github.com/ManoManoTech/homer/blob/main/manifest.json
# -> Install to Workspace
# ---------------------------------------------------------------------------

# https://api.slack.com/apps -> your app -> OAuth & Permissions ->
# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_USER_O_AUTH_ACCESS_TOKEN=

# https://api.slack.com/apps -> your app -> Basic Information ->
# App Credentials -> Signing Secret (Show)
SLACK_SIGNING_SECRET=

# Channel advertised by `/homer help` for support. Create or pick a channel,
# then: open it -> click the channel name -> About tab, the ID (C...) is at the bottom.
SLACK_SUPPORT_CHANNEL_ID=
SLACK_SUPPORT_CHANNEL_NAME=

# Homer skips notifications for a project linked to more channels than this.
SLACK_CHANNEL_NOTIFICATION_THRESHOLD=3

# ---------------------------------------------------------------------------
# start-tunnels.sh only (Homer ignores these)
# ---------------------------------------------------------------------------

# Optional static ngrok domain for GitLab: https://dashboard.ngrok.com -> Domains
# -> claim your free domain, e.g. my-name.ngrok-free.dev
# Leave empty to get a random URL on each run.
GITLAB_NGROK_DOMAIN=

# Project whose webhook points to Homer, as <namespace>/<project>,
# e.g. root/my-project (the path after http://localhost:8929/).
GITLAB_WEBHOOK_PROJECT=

# Create the webhook once: project -> Settings -> Webhooks -> Add new webhook
# (any https:// URL, Secret token = GITLAB_SECRET, triggers: Push, Comments,
# Merge request, Job, Pipeline, Deployment events). Its edit page URL ends in
# /-/hooks/<id>/edit: put <id> here.
GITLAB_WEBHOOK_ID=

# Optional: when set, the script points the Slack app slash command and
# interactivity URLs to the new Homer URL on each run.
# https://api.slack.com/apps -> your app -> Basic Information -> App ID (A...)
SLACK_APP_ID=

# Required when SLACK_APP_ID is set: https://api.slack.com/apps ->
# "Your App Configuration Tokens" (below the app list) -> Generate Token ->
# pick the workspace. Copy both tokens.
# The access token (xoxe.xoxp-...) lasts 12h; the script then uses the refresh
# token (xoxe-...) to get a new pair and rewrites both lines here. A refresh
# token works once: if a run fails mid-rotation, generate a new pair.
SLACK_CONFIG_ACCESS_TOKEN=
SLACK_CONFIG_REFRESH_TOKEN=
