# Copy to .env and fill in the empty values. Never commit .env.
# Homer reads this whole file (env_file in docker-compose.yml).

# --- Homer
HOMER_PORT=3000
API_BASE_PATH=/api/v1/homer
# Email domains used to match GitLab usernames to Slack users, comma separated
EMAIL_DOMAINS=my-domain.com
# Changelog ticket links, must contain {ticketId}
TICKET_MANAGEMENT_URL_PATTERN=https://my-ticket-management.com/view/{ticketId}
REQUEST_BODY_SIZE_LIMIT=5mb

# --- Postgres (homer-postgres container)
# POSTGRES_PORT is both the host port and the port Homer connects to, keep 5432
# unless you also change the container port mapping.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=homer
POSTGRES_PASSWORD=
POSTGRES_DATABASE_NAME=homer

# --- GitLab (homer-gitlab container)
# Initial root password, GitLab rejects weak ones
GITLAB_ROOT_PASSWORD=
# Homer talks to GitLab over the compose network
GITLAB_URL=http://gitlab:8929
# Personal access token (scope: api) of the user Homer acts as, Maintainer of every project
GITLAB_TOKEN=
# Webhook secret token, generate with: openssl rand -base64 32
GITLAB_SECRET=

# --- Slack app (https://api.slack.com/apps -> your app)
# OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
SLACK_BOT_USER_O_AUTH_ACCESS_TOKEN=
# Basic Information -> App Credentials -> Signing Secret
SLACK_SIGNING_SECRET=
# Channel shown by /homer help for support
SLACK_SUPPORT_CHANNEL_ID=
SLACK_SUPPORT_CHANNEL_NAME=
SLACK_CHANNEL_NOTIFICATION_THRESHOLD=3

# --- start-tunnels.sh
# Optional static ngrok domain for GitLab, e.g. my-name.ngrok-free.dev; empty gives a random URL
GITLAB_NGROK_DOMAIN=
# Project whose webhook points to Homer, and the hook id from /-/hooks/<id>/edit
GITLAB_WEBHOOK_PROJECT=root/my-project
GITLAB_WEBHOOK_ID=
# Optional: keeps the Slack app slash command and interactivity URLs pointed at Homer.
# Basic Information -> App ID
SLACK_APP_ID=
# https://api.slack.com/apps -> Your App Configuration Tokens -> Generate Token.
# The access token lasts 12h; the script rotates it with the refresh token and rewrites both here.
SLACK_CONFIG_ACCESS_TOKEN=
SLACK_CONFIG_REFRESH_TOKEN=
